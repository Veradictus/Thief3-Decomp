# Game files: never commit (see CONTRIBUTING.md; buy the game instead)
/orig/*/*
!/orig/*/.gitkeep

# The game's file types, anywhere: binaries, packages, textures, videos,
# maps and data, and assets extracted from them
*.exe
*.dll
*.pdb
*.t3u
*.ibt
*.gmp
*.lbd
*.utx
*.dds
*.tga
*.bik
*.sch
*.csc
*.con
*.cel
*.tim
*.vcb
*.smd
*.sm
*.ion
*.sdb
*.ddb
*.arc
*.int
*.glb

# Build output (generated by configure.py / ninja)
/build/
/build.ninja
/.ninja_*
/objdiff.json

# Local Ghidra database (tools/ghidra_headless.py)
/ghidra/

# Python
/.venv/
__pycache__/
*.pyc

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Launcher build output (Yarn, Vite, Cargo, Tauri); Yarn keeps only its config
/launcher/node_modules/
/launcher/.yarn/*
!/launcher/.yarn/patches/
!/launcher/.yarn/plugins/
!/launcher/.yarn/releases/
/launcher/.pnp.*
/launcher/dist/
/launcher/src-tauri/target/
/launcher/src-tauri/gen/
/launcher/src-tauri/bundle/

# Agent worktrees
/.claude/worktrees/
